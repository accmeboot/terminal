{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "yellow"
    },
    "key": {
      "type": "icon"
    },
    "separator": "  ",
    "size": {
      "maxPrefix": "MB",
      "ndigits": 0
    }
  },
  "logo": {
    "type": "small",
    "padding": {
      "top": 1
    }
  },
  "modules": [
    {
      "color": {
        "at": "red",
        "host": "blue",
        "user": "green"
      },
      "type": "title"
    },
    "break",
    "os",
    "kernel",
    "memory",
    "packages",
    "uptime",
    "break",
    {
      "block": {
        "range": [
          1,
          6
        ]
      },
      "key": "Colors",
      "type": "colors"
    }
  ]
}
